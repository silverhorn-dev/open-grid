OPEN_GRID_PORT=3000
BUILD_VERSION=self-hosted
BUILD_TIMESTAMP=
# Muss exakt dem static-auth-secret des coturn entsprechen,
# sonst antwortet der TURN-Server mit 401 und es gibt keine Relay-Kandidaten.
# Pruefen mit: npm.cmd run turn:check -- <host> 3478 <secret>
TURN_SECRET=replace-with-a-long-random-secret
# Kontaktadresse fuer Web-Push-Dienste (mailto: oder https:).
VAPID_SUBJECT=mailto:admin@example.com
# Optional: feste VAPID-Schluessel. Leer = einmalig generiert und in SQLite gespeichert.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
