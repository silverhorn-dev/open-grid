OPEN_GRID_PORT=3000
BUILD_VERSION=self-hosted
BUILD_TIMESTAMP=
# Startet den mitgelieferten coturn (TURN/STUN) mit; leer lassen ohne eigenen TURN-Server.
COMPOSE_PROFILES=turn
# Hostname des TURN-Servers (DNS zeigt auf diesen Host). Dient auch als coturn-Realm.
TURN_SERVER=turn.example.org
# Optional: abweichender Realm
# TURN_REALM=
# Der mitgelieferte coturn nutzt dasselbe Secret; bei einem externen coturn
# muss es exakt dessen static-auth-secret entsprechen,
# sonst antwortet der TURN-Server mit 401 und es gibt keine Relay-Kandidaten.
# Pruefen mit: npm.cmd run turn:check -- <host> 3478 <secret>
TURN_SECRET=replace-with-a-long-random-secret
# Kontaktadresse fuer Web-Push-Dienste (mailto: oder https:).
VAPID_SUBJECT=mailto:admin@example.com
# Optional: feste VAPID-Schluessel. Leer = einmalig generiert und in SQLite gespeichert.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Info-Seite fuer alle (info-site/): eigene Subdomain, z. B. info.og.example.org (DNS/Tunnel auf denselben
# Container). Leer = Info-Seite unter /info der App-Domain.
INFO_HOST=
# Adresse der App fuer "Zur App" auf der Info-Seite, z. B. https://og.example.org
APP_URL=
# Nachweise (standardmaessig aus): AGE_CHECK=off|confirm|provider, EMAIL_CHECK=off|required.
AGE_CHECK=off
AGE_PROVIDER=
# Fuer AGE_PROVIDER=eudi (EU-Altersnachweis ueber die Wallet): APP_URL setzen (Bindung an die Seite),
# Aussteller aus der EU-Liste (automatisch) und/oder eigene PEM-Dateien.
AGE_TRUST_CERTS=
AGE_TRUSTED_LIST_URL=
AGE_TRUSTED_LIST_SIGNER=
AGE_EUDI_DOCTYPES=
EMAIL_CHECK=off
# E-Mail-Codes: log (nur Server-Log, zum Testen) oder smtp (Mailserver des Betreibers).
EMAIL_TRANSPORT=log
# Fuer EMAIL_TRANSPORT=smtp: smtp://user:pass@host:587 (STARTTLS) oder smtps://user:pass@host:465.
SMTP_URL=
SMTP_FROM=
# Nacktbild-Filter: nsfwjs | nsfwjs-mid | nsfwjs-inception | bumble | nudenet | off
# (alle im Docker-Image enthalten, siehe models/README.md)
NUDITY_MODEL=nudenet
NUDITY_THRESHOLD=
NUDITY_CLASSES=
# 32 Byte base64/hex fuer E-Mail-Verschluesselung und HMACs, z. B. `openssl rand -base64 32`.
SAFETY_KEY=
# IP-Protokoll fuer Anfragen der Strafverfolgung in Tagen (0 = aus, hoechstens 14).
ABUSE_LOG_DAYS=0
# Admin-Panel (/admin): erster Passkey ueber den Setup-Link im Server-Log; optional fester Token
# (wirkt nur, solange noch kein Passkey existiert).
ADMIN_SETUP_TOKEN=
# GIFs (Board T34): off | library | url | library,url | any. Der Router speichert nur Links, keine Dateien.
GIF_SOURCES=any
# Vorschlaege fuer die GIF-Bibliothek erst nach Freigabe im Admin-Panel (true) oder sofort (false).
GIF_LIBRARY_REVIEW=true
GIF_REPORT_HIDE=3
# Nutzer-Meldungen (mit Grund): ab so vielen verschiedenen Meldern im Grid ausgeblendet (0 = nie).
USER_REPORT_HIDE=3
# Nur Melder mit Konto aelter als so viele Stunden zaehlen fuer das Ausblenden (Schutz vor Wegwerf-Konten).
USER_REPORT_MIN_AGE_HOURS=24
# Anbieter-Suche: off | klipy (kostenlos, Schluessel im Klipy-Partner-Panel, Werbung dort aus lassen).
GIF_PROVIDER=off
GIF_PROVIDER_KEY=
GIF_PROVIDER_FILTER=high
# GIFs ueber den Router laden (fremde Server sehen nur den Router); kostet Bandbreite, Standard aus.
GIF_PROXY=off
GIF_MAX_MB=8
