# Nur fuer CI (Jenkinsfile): `docker build -f Dockerfile.test .` fuehrt Syntax-Check und Unit-Tests aus.
# Lokal pruefen: danach `cat test-results/unit.exit` im Image (0 = gruen) oder einfach `npm test` wie gewohnt.
# Ohne Bind-Mount, damit es auch gegen einen entfernten Docker-Daemon laeuft.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Unit-Tests mit Ausgabe wie bisher und zusaetzlich als JUnit (test-results/unit.xml). Ein roter Test bricht den
# Build nicht ab, damit Jenkins die Ergebnisse herausholen kann; der Exit-Code steht in test-results/unit.exit und
# wird im Jenkinsfile ausgewertet. Ein Syntaxfehler (npm run check) bricht sofort ab.
RUN npm run check && npm run build:css && mkdir -p test-results \
    && (node --test --test-reporter=spec --test-reporter-destination=stdout \
        --test-reporter=junit --test-reporter-destination=test-results/unit.xml; echo $? > test-results/unit.exit)
